{
  "name": "openwrt-lite-console",
  "version": "0.10.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && bun scripts/package-ui.ts",
    "test": "bun test tests/frontend",
    "test:e2e": "playwright test",
    "lint": "oxlint frontend scripts/package-ui.ts tests/frontend tests/e2e vite.config.ts playwright.config.ts tests/smoke tests/smoke-server.ts playwright.smoke.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run check:fast && bun run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:fast": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.69.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "wouter": "3.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "bun-types": "1.4.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.4"
}
