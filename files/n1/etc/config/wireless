config wifi-device 'radio0'
    option type 'mac80211'
    option phy 'phy0'
    option band '2g'
    option channel '1'
    option htmode 'HT20'
    option country 'CN'
    option disabled '1'

config wifi-iface 'default_radio0'
    option device 'radio0'
    option ifname 'wlan0'
    option network 'lan'
    option mode 'ap'
    option ssid 'N1'
    option encryption 'psk2'
    option disabled '1'
