#!/bin/sh
# rpcd 固定操作插件：不接受命令、文件路径或 URL；上传只使用固定私有目录。
set -e
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
LOCK=/var/run/router-ui-maintenance.lock
DATA=/usr/libexec/router-ui/maintenance-data.uc
UPLOAD=/tmp/router-ui-upload
OPERATION=/var/run/router-ui-maintenance.json

record_operation() {
    local temporary updated
    updated=$(date +%s) || return 1
    temporary=$(mktemp "$OPERATION.XXXXXX") || return 1
    if printf '{"id":"%s","kind":"%s","state":"%s","error":"%s","updatedAt":%s,"bootId":"%s"}\n' \
        "$operation_id" "$operation_kind" "$1" "${2:-}" "$updated" "$operation_boot" > "$temporary" &&
        mv -f "$temporary" "$OPERATION"; then return 0; fi
    rm -f "$temporary"
    return 1
}
begin_operation() {
    operation_kind=$1
    operation_id=$(cat /proc/sys/kernel/random/uuid) || fail operation_state_failed
    operation_boot=$(cat /proc/sys/kernel/random/boot_id) || fail operation_state_failed
    record_operation accepted || fail operation_state_failed
}
accepted() {
    printf '{"ok":true,"accepted":true,"operationId":"%s"}\n' "$operation_id"
}

upgrade_supported() {
    [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'jdcloud,re-ss-01' ] &&
        [ -x /sbin/sysupgrade ]
}
reset_supported() {
    upgrade_supported && [ -x /sbin/jffs2reset ] &&
        grep -q ' /rom squashfs ' /proc/mounts && grep -q ' / overlay ' /proc/mounts
}
lock() {
    [ "${1:-}" = cleanup ] || { busy_config && fail configuration_busy; }
    mkdir "$LOCK" 2>/dev/null || fail operation_busy
    trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
    trap 'exit 1' HUP INT TERM
    [ "${1:-}" = cleanup ] || { busy_config && fail configuration_busy; }
    return 0
}
check_upload() {
    request=$(ucode "$DATA" check) || { printf '%s\n' "$request"; exit 0; }
    kind=$(printf '%s' "$request" | jsonfilter -e '@.kind')
    expected=$(printf '%s' "$request" | jsonfilter -e '@.sha256')
    actual=$(sha256sum "$UPLOAD/payload")
    [ "${actual%% *}" = "$expected" ] || fail checksum_mismatch
}
validate_upload() {
    case "$kind" in
        restore)
            # ulimit 防止压缩炸弹占满 tmpfs；独立检查 gzip 退出码。
            (ulimit -f 4096; gzip -dc "$UPLOAD/payload" > "$UPLOAD/expanded" 2>/dev/null) || fail invalid_archive
            archive_result=$(ucode "$DATA" archive) || { printf '%s\n' "$archive_result"; exit 0; }
            ;;
        upgrade)
            upgrade_supported || fail unsupported_device
            sysupgrade -T "$UPLOAD/payload" >/dev/null 2>&1 || fail invalid_firmware
            ;;
        *) fail invalid_upload ;;
    esac
}
schedule_reboot() {
    trap - EXIT
    (
        sleep 3
        if busy_config; then record_operation failed configuration_busy || true
        elif record_operation rebooting; then
            ubus call system reboot >/dev/null 2>&1 || record_operation failed reboot_failed || true
        fi
        rmdir "$LOCK" 2>/dev/null || true
    ) </dev/null >/dev/null 2>&1 &
}

busy_config() {
    local entry
    for entry in /var/run/rpcd/snapshot-files/* /var/run/rpcd/snapshot-delta/* /var/run/rpcd/uci-*/* /tmp/.uci/*; do
        [ ! -s "$entry" ] || return 0
    done
    return 1
}
pending_apply() {
    local entry
    for entry in /var/run/rpcd/snapshot-files/*; do
        [ ! -s "$entry" ] || return 0
    done
    return 1
}
fail() {
    if [ -n "${operation_id:-}" ]; then record_operation failed "$1" || true; fi
    printf '{"ok":false,"error":"%s"}\n' "$1"
    exit 0
}

case "$1" in
    list)
        printf '%s\n' '{"status":{},"backup":{},"reboot":{"confirm":true},"upload_start":{"kind":"","size":0,"sha256":""},"upload_chunk":{"token":"","offset":0,"data":""},"upload_cancel":{"token":""},"inspect":{"token":""},"restore":{"token":"","confirm":true},"upgrade":{"token":"","confirm":true},"reset":{"confirm":true},"password":{"current":"","password":"","confirmation":""},"led_status":{},"led_save":{"policy":""},"schedule_status":{},"schedule_save":{"enabled":true,"time":"","days":[]},"time_status":{},"time_save":{"zone":"","enabled":true,"useDhcp":true,"servers":[]}}'
        ;;
    call)
        case "$2" in
            status)
                configuration=false
                busy_config && configuration=true
                operation=false
                [ ! -d "$LOCK" ] || operation=true
                upgrade=false
                reset=false
                pending=false
                pending_apply && pending=true
                operation_record=$(ucode "$DATA" operation) || operation_record=null
                upgrade_supported && upgrade=true
                reset_supported && reset=true
                printf '{"ok":true,"configurationBusy":%s,"operationBusy":%s,"backupLimit":131072,"upgradeSupported":%s,"resetSupported":%s,"firmwareLimit":33554432,"applyPending":%s,"operation":%s}\n' "$configuration" "$operation" "$upgrade" "$reset" "$pending" "${operation_record:-null}"
                ;;
            backup)
                busy_config && fail configuration_busy
                mkdir "$LOCK" 2>/dev/null || fail operation_busy
                directory=
                archive=
                trap '[ -z "$archive" ] || rm -f "$archive"; [ -z "$directory" ] || { rm -f "$directory/config.tar"; rmdir "$directory"; }; rmdir "$LOCK"' EXIT
                trap 'exit 1' HUP INT TERM
                busy_config && fail configuration_busy
                directory=$(mktemp -d /tmp/router-ui-backup.XXXXXX) || fail backup_failed
                archive="$directory/config.tar.gz"
                # 限制临时文件与 ubus 响应体积；较大的自定义备份仍通过 SSH 导出。
                (ulimit -f 256; sysupgrade -b "$archive" >/dev/null 2>&1) || fail backup_failed
                (ulimit -f 4096; gzip -dc "$archive" > "$directory/config.tar") || fail backup_failed
                ucode "$DATA" seal "$directory/config.tar" >/dev/null 2>&1 || fail backup_failed
                (ulimit -f 256; gzip -c "$directory/config.tar" > "$archive") || fail backup_too_large
                size=$(wc -c < "$archive")
                [ "$size" -gt 0 ] && [ "$size" -le 131072 ] || fail backup_too_large
                busy_config && fail configuration_busy
                checksum=$(sha256sum "$archive")
                checksum=${checksum%% *}
                # OpenWrt 默认未启用 BusyBox base64；复用 netifd 已依赖的 ucode。
                encoded=$(ucode -e 'import { readfile } from "fs"; let data = readfile(ARGV[0], 131073); if (type(data) != "string" || length(data) > 131072) exit(1); print(b64enc(data));' "$archive") || fail backup_failed
                printf '{"ok":true,"size":%s,"sha256":"%s","data":"%s"}\n' "$size" "$checksum" "$encoded"
                ;;
            led_status)
                ucode /usr/libexec/router-ui/led-policy.uc status || true
                ;;
            time_status)
                ucode /usr/libexec/router-ui/time-settings.uc status
                ;;
            time_save)
                lock
                ucode /usr/libexec/router-ui/time-settings.uc save
                ;;
            schedule_status)
                ucode /usr/libexec/router-ui/schedule.uc status
                ;;
            schedule_save)
                lock
                /usr/libexec/router-ui/scheduled-reboot configure
                ;;
            led_save)
                lock
                result=$(ucode /usr/libexec/router-ui/led-policy.uc save) || { printf '%s\n' "$result"; exit 0; }
                /usr/libexec/router-ui/led-state configure >/dev/null 2>&1 || fail led_apply_failed
                printf '%s\n' "$result"
                ;;
            led_repair)
                lock
                /usr/libexec/router-ui/led-state configure >/dev/null 2>&1 || fail led_apply_failed
                printf '%s\n' '{"ok":true}'
                ;;
            password)
                lock
                ucode /usr/libexec/router-ui/password.uc
                ;;
            upload_start)
                lock
                # 每个文件上限 32 MiB，另留 8 MiB 给系统和校验。
                available=$(df -Pk /tmp | awk 'NR == 2 { print $4 }')
                [ "${available:-0}" -ge 40960 ] || fail insufficient_space
                ucode "$DATA" start || true
                ;;
            upload_chunk|upload_cancel)
                mode=append
                if [ "$2" = upload_cancel ]; then mode=cancel; lock cleanup; else lock; fi
                ucode "$DATA" "$mode" || true
                ;;
            inspect|restore|upgrade)
                lock
                check_upload
                [ "$2" = inspect ] || [ "$2" = "$kind" ] || fail invalid_upload
                validate_upload
                busy_config && fail configuration_busy
                if [ "$2" = inspect ]; then
                    if [ "$kind" = restore ]; then printf '%s\n' "$archive_result";
                    else printf '%s\n' '{"ok":true,"verified":true}'; fi
                    exit 0
                fi
                confirmed=$(printf '%s' "$request" | jsonfilter -e '@.confirm')
                [ "$confirmed" = true ] || fail confirmation_required
                begin_operation "$kind"
                if [ "$kind" = restore ]; then
                    record_operation running || fail operation_state_failed
                    # 校验后仅用经过过滤的 etc 文件恢复；失败不安排重启。
                    gzip -c "$UPLOAD/restore.tar" > "$UPLOAD/expanded" || fail restore_failed
                    (ulimit -f 4096; sysupgrade -b "$UPLOAD/rescue.tar.gz" >/dev/null 2>&1) || fail backup_failed
                    if ! sysupgrade -r "$UPLOAD/expanded" >/dev/null 2>&1; then
                        sysupgrade -r "$UPLOAD/rescue.tar.gz" >/dev/null 2>&1 || fail restore_rollback_failed
                        fail restore_failed
                    fi
                    rm -f "$UPLOAD/payload" "$UPLOAD/expanded" "$UPLOAD/restore.tar" "$UPLOAD/metadata" "$UPLOAD/rescue.tar.gz"
                    rmdir "$UPLOAD"
                    schedule_reboot
                else
                    # 不开放强制刷写或保留旧配置，延迟后再次校验哈希与事务状态。
                    trap - EXIT
                    (
                        sleep 3
                        checksum=$(sha256sum "$UPLOAD/payload" 2>/dev/null) || checksum=missing
                        if busy_config; then record_operation failed configuration_busy || true
                        elif [ "${checksum%% *}" != "$expected" ]; then record_operation failed checksum_mismatch || true
                        elif ! upgrade_supported; then record_operation failed unsupported_device || true
                        elif record_operation running; then
                            if sysupgrade -n "$UPLOAD/payload" >/dev/null 2>&1; then
                                record_operation rebooting || true
                            else record_operation failed upgrade_failed || true; fi
                        fi
                        rmdir "$LOCK" 2>/dev/null || true
                    ) </dev/null >/dev/null 2>&1 &
                fi
                accepted
                ;;
            reset)
                confirmed=$(jsonfilter -e '@.confirm' 2>/dev/null) || fail confirmation_required
                [ "$confirmed" = true ] || fail confirmation_required
                reset_supported || fail unsupported_device
                lock
                begin_operation reset
                # jffs2reset 只用于经过检查的 squashfs/overlay AX1800。
                trap - EXIT
                (
                    sleep 3
                    if busy_config; then record_operation failed configuration_busy || true
                    elif ! reset_supported; then record_operation failed unsupported_device || true
                    elif record_operation running; then
                        if jffs2reset -y >/dev/null 2>&1; then
                            if record_operation rebooting; then
                                ubus call system reboot >/dev/null 2>&1 || record_operation failed reboot_failed || true
                            fi
                        else record_operation failed reset_failed || true; fi
                    fi
                    rmdir "$LOCK" 2>/dev/null || true
                ) </dev/null >/dev/null 2>&1 &
                accepted
                ;;
            reboot)
                confirmed=$(jsonfilter -e '@.confirm' 2>/dev/null) || fail confirmation_required
                [ "$confirmed" = true ] || fail confirmation_required
                lock
                begin_operation reboot
                # 先返回响应，再次检查其他窗口的配置事务，最后通过 procd 重启。
                schedule_reboot
                accepted
                ;;
            *) fail unsupported_method ;;
        esac
        ;;
    *) exit 1 ;;
esac
