{
  "router-ui": {
    "description": "设备状态、LAN、DNS 与无线设置，以及应用确认和回滚",
    "read": {
      "ubus": {
        "system": ["board", "info"],
        "network.interface": ["dump"],
        "network.wireless": ["status"],
        "iwinfo": ["info", "assoclist"],
        "router.maintenance": ["status", "backup"],
        "session": ["access"],
        "uci": ["get", "changes"]
