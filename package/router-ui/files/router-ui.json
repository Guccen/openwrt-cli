{
  "router-ui": {
    "description": "设备状态、LAN、DNS 与无线设置，以及应用确认和回滚",
    "read": {
      "ubus": {
        "system": ["board", "info"],
        "network.interface": ["dump"],
        "iwinfo": ["info", "assoclist", "phyname", "freqlist", "countrylist"],
        "router.status": ["summary", "clients", "wireless"],
        "router.diagnostics": ["run"],
        "router.maintenance": ["status", "backup", "led_status", "time_status", "schedule_status"],
        "session": ["access"],
        "uci": ["get", "changes"]
      },
      "uci": ["network", "dhcp", "wireless", "firewall"]
    },
    "write": {
      "ubus": {
        "session": ["destroy"],
        "router.maintenance": [
          "reboot",
          "upload_start",
          "upload_chunk",
          "upload_cancel",
          "inspect",
          "restore",
          "upgrade",
          "reset",
          "password",
          "led_save",
          "time_save",
          "schedule_save"
        ],
        "uci": ["add", "set", "delete", "revert", "apply", "confirm", "rollback"]
      },
      "uci": ["network", "dhcp", "wireless", "firewall"]
    }
  }
}
