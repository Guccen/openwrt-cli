#!/bin/sh
# 通过启动阶段和网络接口事件配置内核 LED 触发器，不创建周期任务。
set -e
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
HELPER=/usr/libexec/router-ui/led-policy.uc
LOCK=/var/run/router-ui-led.lock
mode=${1:-start}

if ! mkdir "$LOCK" 2>/dev/null; then
    case "$mode" in start|boot) exit 0 ;; *) exit 1 ;; esac
fi
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
trap 'exit 1' HUP INT TERM

case "$mode" in
    configure)
        ucode "$HELPER" configure
        ;;
    start)
        ucode "$HELPER" start
        ;;
    boot)
        ucode "$HELPER" boot
        ;;
    stop|uninstall)
        ucode "$HELPER" restore
        ;;
    *) exit 1 ;;
esac
